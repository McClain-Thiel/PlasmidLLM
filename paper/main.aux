\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Left: ``useful plasmid'' rate vs.\ fidelity threshold $T$ for both checkpoints with paired bootstrap $95\%$ bands. Right: paired delta (GRPO $-$ base) across $T$. The effect size peaks near $T=0.5$, the regime where the composite metric distinguishes ``plausible but generic'' plasmids from plausible \emph  {and} on-prompt plasmids.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:ceiling}{{3}{7}{Left: ``useful plasmid'' rate vs.\ fidelity threshold $T$ for both checkpoints with paired bootstrap $95\%$ bands. Right: paired delta (GRPO $-$ base) across $T$. The effect size peaks near $T=0.5$, the regime where the composite metric distinguishes ``plausible but generic'' plasmids from plausible \emph {and} on-prompt plasmids}{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Oracle best-of-$K$ on the paired $n=1000$ evaluation. Rejection sampling does not close the GRPO gap: at $K=4$ the post-GRPO model still leads by $+10.8$ pp on the useful metric ($p\approx 2\times 10^{-12}$). Base-at-$K=4$ barely matches GRPO-at-$K=2$.}}{7}{table.caption.8}\protected@file@percent }
\newlabel{tab:bon}{{4}{7}{Oracle best-of-$K$ on the paired $n=1000$ evaluation. Rejection sampling does not close the GRPO gap: at $K=4$ the post-GRPO model still leads by $+10.8$ pp on the useful metric ($p\approx 2\times 10^{-12}$). Base-at-$K=4$ barely matches GRPO-at-$K=2$}{table.caption.8}{}}
