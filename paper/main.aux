\@writefile{toc}{\contentsline {paragraph}{GRPO training run note.}{11}{section*.18}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Pre-GRPO base model, small temperature sweep ($n=100$ per cell; matched $n=1000$ run for $t=0.7$ for comparison). Base prompt fidelity peaks at $t=0.3$ ($37.8\%$) and degrades at higher temperatures; the matched $t=0.7$ setting is therefore already near the base's optimum, so the GRPO advantage reported in the main text is not explained by temperature tuning on the base.}}{12}{figure.caption.16}\protected@file@percent }
\newlabel{fig:temperature_sweep}{{6}{12}{Pre-GRPO base model, small temperature sweep ($n=100$ per cell; matched $n=1000$ run for $t=0.7$ for comparison). Base prompt fidelity peaks at $t=0.3$ ($37.8\%$) and degrades at higher temperatures; the matched $t=0.7$ setting is therefore already near the base's optimum, so the GRPO advantage reported in the main text is not explained by temperature tuning on the base}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Oracle best-of-$K$ for $K \in \{1, 2, 4\}$ on the paired $n=1000$ evaluation. Left: structural plausibility. Right: composite ``useful'' rate (plausible $\land $ fidelity $\geq 0.5$). Shaded bands are Wilson $95\%$ CIs. GRPO stays strictly above base across all $K$; rejection sampling does not close the gap even with ground-truth ranking.}}{12}{figure.caption.17}\protected@file@percent }
\newlabel{fig:best_of_k}{{7}{12}{Oracle best-of-$K$ for $K \in \{1, 2, 4\}$ on the paired $n=1000$ evaluation. Left: structural plausibility. Right: composite ``useful'' rate (plausible $\land $ fidelity $\geq 0.5$). Shaded bands are Wilson $95\%$ CIs. GRPO stays strictly above base across all $K$; rejection sampling does not close the gap even with ground-truth ranking}{figure.caption.17}{}}
