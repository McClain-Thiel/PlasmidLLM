\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Three exemplar generations spanning the quality range. Each row: prompt component list (left) and pLannotate annotation map (right), coloured by feature type. (a) \texttt  {gen\_271}, clean success: $5/5$ hard tokens recovered, plasmid is a coherent mammalian/\textit  {E.~coli} shuttle vector. (b) \texttt  {gen\_223}, typical single-shot: $3/6$ tokens recovered, structurally plausible plasmid on a different backbone than requested. (c) \texttt  {gen\_7}, \texttt  {COPY\_LOW} + rare-AMR failure: prompt asked for low-copy + chloramphenicol/tetracycline resistance; model emitted high-copy origins and ampicillin resistance instead.}}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:exemplars}{{2}{6}{Three exemplar generations spanning the quality range. Each row: prompt component list (left) and pLannotate annotation map (right), coloured by feature type. (a) \texttt {gen\_271}, clean success: $5/5$ hard tokens recovered, plasmid is a coherent mammalian/\textit {E.~coli} shuttle vector. (b) \texttt {gen\_223}, typical single-shot: $3/6$ tokens recovered, structurally plausible plasmid on a different backbone than requested. (c) \texttt {gen\_7}, \texttt {COPY\_LOW} + rare-AMR failure: prompt asked for low-copy + chloramphenicol/tetracycline resistance; model emitted high-copy origins and ampicillin resistance instead}{figure.caption.4}{}}
