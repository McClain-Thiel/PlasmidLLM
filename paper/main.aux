\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Per-category prompt fidelity for pre- vs.\ post-GRPO, paired $n=1000$. Denominators are number of (prompt, token) pairs across the $1000$ prompts for each category. The TAG regression reflects that short peptide tags are rarely credited by the training-time BLAST-based reward.}}{6}{table.caption.5}\protected@file@percent }
\newlabel{tab:conditional}{{2}{6}{Per-category prompt fidelity for pre- vs.\ post-GRPO, paired $n=1000$. Denominators are number of (prompt, token) pairs across the $1000$ prompts for each category. The TAG regression reflects that short peptide tags are rarely credited by the training-time BLAST-based reward}{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Composite ``useful plasmid'' rate (plausible \emph  {and} fidelity $\geq T$) on the paired $n=1000$ evaluation, with paired bootstrap $95\%$ CIs on the delta and McNemar $p$. At $T=0.5$ the GRPO gain is $+9.8$ pp ($p\approx 6\times 10^{-6}$); GRPO is significantly better at every positive threshold.}}{6}{table.caption.6}\protected@file@percent }
\newlabel{tab:useful}{{3}{6}{Composite ``useful plasmid'' rate (plausible \emph {and} fidelity $\geq T$) on the paired $n=1000$ evaluation, with paired bootstrap $95\%$ CIs on the delta and McNemar $p$. At $T=0.5$ the GRPO gain is $+9.8$ pp ($p\approx 6\times 10^{-6}$); GRPO is significantly better at every positive threshold}{table.caption.6}{}}
