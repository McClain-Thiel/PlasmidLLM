\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Structural plausibility of generated plasmids on the paired $n=1000$ evaluation. A pass requires pLannotate to detect all five essential element classes (origin of replication, selection marker, promoter, terminator, and coding sequence); the four columns show pass rates for each except coding sequence, which exceeded $95\%$ for all model outputs and is omitted. The $+2.8$ pp pre-/post-GRPO gap is not significant (paired bootstrap $95\%$ CI $[-1.4, +7.1]$, McNemar $p=0.21$).}}{6}{table.caption.7}\protected@file@percent }
\newlabel{tab:plausibility}{{1}{6}{Structural plausibility of generated plasmids on the paired $n=1000$ evaluation. A pass requires pLannotate to detect all five essential element classes (origin of replication, selection marker, promoter, terminator, and coding sequence); the four columns show pass rates for each except coding sequence, which exceeded $95\%$ for all model outputs and is omitted. The $+2.8$ pp pre-/post-GRPO gap is not significant (paired bootstrap $95\%$ CI $[-1.4, +7.1]$, McNemar $p=0.21$)}{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-category prompt fidelity (paired $n=1000$, matched sampling). GRPO improves every category except epitope tags, which regress because the training-time reward signal rarely credits them. Error bars are Wilson $95\%$ intervals.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:hit_rate}{{3}{6}{Per-category prompt fidelity (paired $n=1000$, matched sampling). GRPO improves every category except epitope tags, which regress because the training-time reward signal rarely credits them. Error bars are Wilson $95\%$ intervals}{figure.caption.8}{}}
