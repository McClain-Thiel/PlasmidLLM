\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Prompt fidelity and conditional generation}{5}{subsection.5.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Structural plausibility of generated plasmids on the paired $n=1000$ evaluation. A pass requires pLannotate to detect all five essential element classes (origin of replication, selection marker, promoter, terminator, and coding sequence); the four columns show pass rates for each except coding sequence, which exceeded $95\%$ for all model outputs and is omitted. The $+2.8$ pp pre-/post-GRPO gap is not significant (paired bootstrap $95\%$ CI $[-1.4, +7.1]$, McNemar $p=0.21$).}}{6}{table.caption.7}\protected@file@percent }
\newlabel{tab:plausibility}{{1}{6}{Structural plausibility of generated plasmids on the paired $n=1000$ evaluation. A pass requires pLannotate to detect all five essential element classes (origin of replication, selection marker, promoter, terminator, and coding sequence); the four columns show pass rates for each except coding sequence, which exceeded $95\%$ for all model outputs and is omitted. The $+2.8$ pp pre-/post-GRPO gap is not significant (paired bootstrap $95\%$ CI $[-1.4, +7.1]$, McNemar $p=0.21$)}{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-category prompt fidelity (paired $n=1000$, matched sampling). GRPO improves every category except epitope tags, which regress because the training-time reward signal rarely credits them. Error bars are Wilson $95\%$ intervals.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:hit_rate}{{3}{6}{Per-category prompt fidelity (paired $n=1000$, matched sampling). GRPO improves every category except epitope tags, which regress because the training-time reward signal rarely credits them. Error bars are Wilson $95\%$ intervals}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Soft-token conditioning: does the model use the metadata it was trained on?}{6}{subsection.5.3}\protected@file@percent }
\newlabel{sec:soft-tokens}{{5.3}{6}{Soft-token conditioning: does the model use the metadata it was trained on?}{subsection.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Per-prompt fidelity, base model ($x$-axis) vs.\ post-GRPO ($y$-axis) for each prompt with $n_{\text  {requested}}>0$. Marker jitter is added to separate points that land on shared fractions (e.g., 1/2, 2/3). Point colour encodes the number of tokens requested per prompt; marginal histograms show each model's univariate distribution. $46.3\%$ of prompts improve under GRPO, $33.5\%$ regress, and $20.1\%$ are unchanged; the improvement is broadly distributed across prompt complexity rather than concentrated on simple prompts.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:scatter}{{4}{7}{Per-prompt fidelity, base model ($x$-axis) vs.\ post-GRPO ($y$-axis) for each prompt with $n_{\text {requested}}>0$. Marker jitter is added to separate points that land on shared fractions (e.g., 1/2, 2/3). Point colour encodes the number of tokens requested per prompt; marginal histograms show each model's univariate distribution. $46.3\%$ of prompts improve under GRPO, $33.5\%$ regress, and $20.1\%$ are unchanged; the improvement is broadly distributed across prompt complexity rather than concentrated on simple prompts}{figure.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Per-category hard-token fidelity for pre- vs.\ post-GRPO, paired $n=1000$. Denominators are (prompt, token) pairs for each category. REP tokens (replication proteins) appear in $<1\%$ of evaluation prompts and are omitted for space. The TAG regression reflects that short peptide tags are rarely detected by the BLAST-based reward.}}{7}{table.caption.10}\protected@file@percent }
\newlabel{tab:conditional}{{2}{7}{Per-category hard-token fidelity for pre- vs.\ post-GRPO, paired $n=1000$. Denominators are (prompt, token) pairs for each category. REP tokens (replication proteins) appear in $<1\%$ of evaluation prompts and are omitted for space. The TAG regression reflects that short peptide tags are rarely detected by the BLAST-based reward}{table.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Per-token hit rate, rank-ordered by the maximum of the base and GRPO rates. Each row shows one hard token: base (grey) and GRPO (green) dots connected by a light line to highlight the shift. Category colour strip on the far left. Right panel is $n_{\text  {requested}}$ in the paired eval on a log scale. The figure makes two patterns visible: GRPO uniformly lifts the already-detectable tokens, and a long tail of rare tokens stays at zero in both runs (the zero-hit tail is the same set that explains the TAG regression and the \texttt  {COPY\_LOW} soft-token failure in Section~\ref {sec:soft-tokens}).}}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:per-token}{{5}{8}{Per-token hit rate, rank-ordered by the maximum of the base and GRPO rates. Each row shows one hard token: base (grey) and GRPO (green) dots connected by a light line to highlight the shift. Category colour strip on the far left. Right panel is $n_{\text {requested}}$ in the paired eval on a log scale. The figure makes two patterns visible: GRPO uniformly lifts the already-detectable tokens, and a long tail of rare tokens stays at zero in both runs (the zero-hit tail is the same set that explains the TAG regression and the \texttt {COPY\_LOW} soft-token failure in Section~\ref {sec:soft-tokens})}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Soft-token discrimination. For each soft value with a biologically meaningful probe, $\Delta $ is the difference in probe-hit rate between prompts that carry that tag and prompts that carry some other value in the same category; error bars are bootstrap $95\%$ intervals; stars mark Fisher $p<0.05$ ($\ast $), $<0.01$ ($\ast \ast $), $<0.001$ ($\ast \ast \ast $). \texttt  {VEC\_LENTIVIRAL} and \texttt  {VEC\_AAV} show large, significant conditioning effects in both the pretrained base and the post-GRPO model. Most other tags are indistinguishable from zero; GRPO preserves but does not extend the pattern, consistent with soft tokens being absent from the reward.}}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:soft-token-forest}{{6}{9}{Soft-token discrimination. For each soft value with a biologically meaningful probe, $\Delta $ is the difference in probe-hit rate between prompts that carry that tag and prompts that carry some other value in the same category; error bars are bootstrap $95\%$ intervals; stars mark Fisher $p<0.05$ ($\ast $), $<0.01$ ($\ast \ast $), $<0.001$ ($\ast \ast \ast $). \texttt {VEC\_LENTIVIRAL} and \texttt {VEC\_AAV} show large, significant conditioning effects in both the pretrained base and the post-GRPO model. Most other tags are indistinguishable from zero; GRPO preserves but does not extend the pattern, consistent with soft tokens being absent from the reward}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Viable versus useful}{9}{subsection.5.4}\protected@file@percent }
\newlabel{sec:useful}{{5.4}{9}{Viable versus useful}{subsection.5.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \texttt  {COPY\_} conditioning, stacked by outcome. \emph  {correct} = the requested copy class's origin was detected; \emph  {wrong} = the opposing class's origin was detected instead; \emph  {unclassified} = a non-discriminative origin (e.g.\ ORI\_F1, ORI\_SV40, ORI\_2$\mu $) was detected; \emph  {no\_signal} = no origin detected. \texttt  {COPY\_HIGH} partially works in both runs; \texttt  {COPY\_LOW} is ignored --- the model outputs a high-copy origin far more often than a low-copy one when low copy is requested.}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:soft-token-copy}{{7}{10}{\texttt {COPY\_} conditioning, stacked by outcome. \emph {correct} = the requested copy class's origin was detected; \emph {wrong} = the opposing class's origin was detected instead; \emph {unclassified} = a non-discriminative origin (e.g.\ ORI\_F1, ORI\_SV40, ORI\_2$\mu $) was detected; \emph {no\_signal} = no origin detected. \texttt {COPY\_HIGH} partially works in both runs; \texttt {COPY\_LOW} is ignored --- the model outputs a high-copy origin far more often than a low-copy one when low copy is requested}{figure.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Oracle best-of-$K$ results (useful metric, $T=0.5$). The GRPO gap is preserved at every $K$; base-at-$K=4$ barely reaches GRPO-at-$K=2$.}}{10}{table.caption.14}\protected@file@percent }
\newlabel{tab:bon}{{3}{10}{Oracle best-of-$K$ results (useful metric, $T=0.5$). The GRPO gap is preserved at every $K$; base-at-$K=4$ barely reaches GRPO-at-$K=2$}{table.caption.14}{}}
