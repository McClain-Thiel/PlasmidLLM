\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Pre-GRPO base model, small temperature sweep ($n=100$ per cell; matched $n=1000$ run for $t=0.7$ for comparison). Base prompt fidelity peaks at $t=0.3$ ($37.8\%$) and degrades at higher temperatures; the matched $t=0.7$ setting is therefore already near the base's optimum, so the GRPO advantage reported in the main text is not explained by temperature tuning on the base.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:temperature_sweep}{{4}{9}{Pre-GRPO base model, small temperature sweep ($n=100$ per cell; matched $n=1000$ run for $t=0.7$ for comparison). Base prompt fidelity peaks at $t=0.3$ ($37.8\%$) and degrades at higher temperatures; the matched $t=0.7$ setting is therefore already near the base's optimum, so the GRPO advantage reported in the main text is not explained by temperature tuning on the base}{figure.caption.11}{}}
