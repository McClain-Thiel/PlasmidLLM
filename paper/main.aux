\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Structural plausibility of generated plasmids on the paired $n=1000$ evaluation. A pass requires detection of all five essential components (origin of replication, selection marker, promoter, terminator, coding sequence) by pLannotate. The $+2.8$ pp pre-/post-GRPO gap is not significant (paired bootstrap $95\%$ CI $[-1.4, +7.1]$, McNemar $p=0.21$).}}{5}{table.caption.3}\protected@file@percent }
\newlabel{tab:plausibility}{{1}{5}{Structural plausibility of generated plasmids on the paired $n=1000$ evaluation. A pass requires detection of all five essential components (origin of replication, selection marker, promoter, terminator, coding sequence) by pLannotate. The $+2.8$ pp pre-/post-GRPO gap is not significant (paired bootstrap $95\%$ CI $[-1.4, +7.1]$, McNemar $p=0.21$)}{table.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Per-category prompt fidelity (paired $n=1000$, matched sampling). GRPO improves every category except epitope tags, which regress because the training-time reward signal rarely credits them. Error bars are Wilson $95\%$ intervals.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:hit_rate}{{2}{5}{Per-category prompt fidelity (paired $n=1000$, matched sampling). GRPO improves every category except epitope tags, which regress because the training-time reward signal rarely credits them. Error bars are Wilson $95\%$ intervals}{figure.caption.4}{}}
