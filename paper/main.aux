\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Host-conditional codon usage. For each plasmid we compute $\Delta = \mathrm  {CAI}_{\mathrm  {yeast}} - \mathrm  {CAI}_{\mathrm  {ecoli}}$ across predicted ORFs (Prodigal). The yeast-vs-\textit  {E.~coli} contrast isolates codon-preference signal from the GC confound that affects Sharp--Li CAI. Real plasmids show a clean diagonal across four host classes (top section). Generated plasmids reproduce the diagonal partially: the post-GRPO model direction-matches real plasmids on three of four host classes; the supervised base on two of four. Bars are bootstrap $95\%$ CIs over plasmids; rows whose CI excludes zero are significant at $p < 0.05$.}}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:cai}{{5}{9}{Host-conditional codon usage. For each plasmid we compute $\Delta = \mathrm {CAI}_{\mathrm {yeast}} - \mathrm {CAI}_{\mathrm {ecoli}}$ across predicted ORFs (Prodigal). The yeast-vs-\textit {E.~coli} contrast isolates codon-preference signal from the GC confound that affects Sharp--Li CAI. Real plasmids show a clean diagonal across four host classes (top section). Generated plasmids reproduce the diagonal partially: the post-GRPO model direction-matches real plasmids on three of four host classes; the supervised base on two of four. Bars are bootstrap $95\%$ CIs over plasmids; rows whose CI excludes zero are significant at $p < 0.05$}{figure.caption.8}{}}
