\@writefile{toc}{\contentsline {paragraph}{GRPO training run note.}{14}{section*.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Pre-GRPO base model, small temperature sweep ($n=100$ per cell; matched $n=1000$ run for $t=0.7$ for comparison). Base prompt fidelity peaks at $t=0.3$ ($37.8\%$) and degrades at higher temperatures; the matched $t=0.7$ setting is therefore already near the base's optimum, so the GRPO advantage reported in the main text is not explained by temperature tuning on the base.}}{15}{figure.caption.19}\protected@file@percent }
\newlabel{fig:temperature_sweep}{{9}{15}{Pre-GRPO base model, small temperature sweep ($n=100$ per cell; matched $n=1000$ run for $t=0.7$ for comparison). Base prompt fidelity peaks at $t=0.3$ ($37.8\%$) and degrades at higher temperatures; the matched $t=0.7$ setting is therefore already near the base's optimum, so the GRPO advantage reported in the main text is not explained by temperature tuning on the base}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Oracle best-of-$K$ for $K \in \{1, 2, 4\}$ on the paired $n=1000$ evaluation. Left: structural plausibility. Right: composite ``useful'' rate (plausible $\land $ fidelity $\geq 0.5$). Shaded bands are Wilson $95\%$ CIs. GRPO stays strictly above base across all $K$; rejection sampling does not close the gap even with ground-truth ranking.}}{15}{figure.caption.20}\protected@file@percent }
\newlabel{fig:best_of_k}{{10}{15}{Oracle best-of-$K$ for $K \in \{1, 2, 4\}$ on the paired $n=1000$ evaluation. Left: structural plausibility. Right: composite ``useful'' rate (plausible $\land $ fidelity $\geq 0.5$). Shaded bands are Wilson $95\%$ CIs. GRPO stays strictly above base across all $K$; rejection sampling does not close the gap even with ground-truth ranking}{figure.caption.20}{}}
