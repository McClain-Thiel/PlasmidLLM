\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces PlasmidLM training and inference pipeline. \textbf  {(A)} Raw Addgene plasmid sequences are annotated with pLannotate to identify functional elements, which are mapped to hard component tokens (e.g., \texttt  {<ORI\_COLE1>}) via the motif registry and supplemented with soft metadata tokens (vector type, species, copy number). \textbf  {(B)} Prompt-paired training: the full sequence is paired with its token prompt and trained with next-token prediction. \textbf  {(C)} GRPO post-training: the policy generates $G=8$ completions per prompt, scored by BLAST alignment against the motif registry; group-normalized rewards update the policy with a KL constraint to the frozen reference. \textbf  {(D)} Inference: a user-supplied token list conditions generation autoregressively.}}{4}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline}{{1}{4}{PlasmidLM training and inference pipeline. \textbf {(A)} Raw Addgene plasmid sequences are annotated with pLannotate to identify functional elements, which are mapped to hard component tokens (e.g., \texttt {<ORI\_COLE1>}) via the motif registry and supplemented with soft metadata tokens (vector type, species, copy number). \textbf {(B)} Prompt-paired training: the full sequence is paired with its token prompt and trained with next-token prediction. \textbf {(C)} GRPO post-training: the policy generates $G=8$ completions per prompt, scored by BLAST alignment against the motif registry; group-normalized rewards update the policy with a KL constraint to the frozen reference. \textbf {(D)} Inference: a user-supplied token list conditions generation autoregressively}{figure.caption.2}{}}
