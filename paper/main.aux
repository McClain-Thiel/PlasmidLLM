\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Per-prompt fidelity: base model ($x$-axis) vs.\ post-GRPO ($y$-axis) for each of the 1,000 evaluation prompts. Points above the diagonal improved under GRPO; points below regressed. Color indicates number of tokens requested per prompt. The improvement is distributed broadly across prompt complexity rather than concentrated on simple prompts.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:scatter}{{4}{7}{Per-prompt fidelity: base model ($x$-axis) vs.\ post-GRPO ($y$-axis) for each of the 1,000 evaluation prompts. Points above the diagonal improved under GRPO; points below regressed. Color indicates number of tokens requested per prompt. The improvement is distributed broadly across prompt complexity rather than concentrated on simple prompts}{figure.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Per-category hard-token fidelity for pre- vs.\ post-GRPO, paired $n=1000$. Denominators are (prompt, token) pairs for each category. REP tokens (replication proteins) appear in $<1\%$ of evaluation prompts and are omitted for space. The TAG regression reflects that short peptide tags are rarely detected by the BLAST-based reward.}}{7}{table.caption.10}\protected@file@percent }
\newlabel{tab:conditional}{{2}{7}{Per-category hard-token fidelity for pre- vs.\ post-GRPO, paired $n=1000$. Denominators are (prompt, token) pairs for each category. REP tokens (replication proteins) appear in $<1\%$ of evaluation prompts and are omitted for space. The TAG regression reflects that short peptide tags are rarely detected by the BLAST-based reward}{table.caption.10}{}}
