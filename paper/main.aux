\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Pre-GRPO base model, small temperature sweep ($n=100$ per cell; matched $n=1000$ run for $t=0.7$ for comparison). Base prompt fidelity peaks at $t=0.3$ ($37.8\%$) and degrades at higher temperatures; the matched $t=0.7$ setting is therefore already near the base's optimum, so the GRPO advantage reported in the main text is not explained by temperature tuning on the base.}}{18}{figure.caption.17}\protected@file@percent }
\newlabel{fig:temperature_sweep}{{9}{18}{Pre-GRPO base model, small temperature sweep ($n=100$ per cell; matched $n=1000$ run for $t=0.7$ for comparison). Base prompt fidelity peaks at $t=0.3$ ($37.8\%$) and degrades at higher temperatures; the matched $t=0.7$ setting is therefore already near the base's optimum, so the GRPO advantage reported in the main text is not explained by temperature tuning on the base}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Per-token hit rate, rank-ordered by the maximum of the base and GRPO rates. Each row shows one hard token: base (grey) and GRPO (green) dots connected by a light line to highlight the shift. Category colour strip on the far left. Right panel is $n_{\text  {requested}}$ in the paired eval on a log scale. The figure makes two patterns visible: GRPO uniformly lifts the already-detectable tokens, and a long tail of rare tokens stays at zero in both runs (the zero-hit tail is the same set that explains the TAG regression and the \texttt  {COPY\_LOW} soft-token failure in Section~\ref {sec:soft-tokens}).}}{19}{figure.caption.18}\protected@file@percent }
\newlabel{fig:per-token}{{10}{19}{Per-token hit rate, rank-ordered by the maximum of the base and GRPO rates. Each row shows one hard token: base (grey) and GRPO (green) dots connected by a light line to highlight the shift. Category colour strip on the far left. Right panel is $n_{\text {requested}}$ in the paired eval on a log scale. The figure makes two patterns visible: GRPO uniformly lifts the already-detectable tokens, and a long tail of rare tokens stays at zero in both runs (the zero-hit tail is the same set that explains the TAG regression and the \texttt {COPY\_LOW} soft-token failure in Section~\ref {sec:soft-tokens})}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Hard-token vocabulary scope on the held-out benchmark, as a treemap. Tile area is the number of times the token appears in evaluation prompts; tile colour is the post-GRPO hit rate ($0$--$60\%$ red$\to $green scale). The four large green tiles in the upper-left (\texttt  {ELEM\_TRACRRNA}, \texttt  {ELEM\_IRES}, \texttt  {ORI\_COLE1}, \texttt  {PROM\_AMPR}) carry most of the evaluation mass and achieve $50$--$58\%$ hit rates. The long tail of small dark tiles on the right is the zero-hit set: rare antibiotic resistance markers, rare origins, and most short epitope tags. \texttt  {REP\_*} tokens have no evaluation prompts and are omitted. Companion to Figure~\ref {fig:per-token}, which shows base$\to $GRPO movement; the treemap shows scope of vocabulary at a glance.}}{20}{figure.caption.19}\protected@file@percent }
\newlabel{fig:vocab_treemap}{{11}{20}{Hard-token vocabulary scope on the held-out benchmark, as a treemap. Tile area is the number of times the token appears in evaluation prompts; tile colour is the post-GRPO hit rate ($0$--$60\%$ red$\to $green scale). The four large green tiles in the upper-left (\texttt {ELEM\_TRACRRNA}, \texttt {ELEM\_IRES}, \texttt {ORI\_COLE1}, \texttt {PROM\_AMPR}) carry most of the evaluation mass and achieve $50$--$58\%$ hit rates. The long tail of small dark tiles on the right is the zero-hit set: rare antibiotic resistance markers, rare origins, and most short epitope tags. \texttt {REP\_*} tokens have no evaluation prompts and are omitted. Companion to Figure~\ref {fig:per-token}, which shows base$\to $GRPO movement; the treemap shows scope of vocabulary at a glance}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Soft-token discrimination. For each soft value with a biologically meaningful probe, $\Delta $ is the difference in probe-hit rate between prompts that carry that tag and prompts that carry some other value in the same category; error bars are bootstrap $95\%$ intervals; stars mark Fisher $p<0.05$ ($\ast $), $<0.01$ ($\ast \ast $), $<0.001$ ($\ast \ast \ast $). \texttt  {VEC\_LENTIVIRAL} and \texttt  {VEC\_AAV} show large, significant conditioning effects in both the pretrained base and the post-GRPO model. Most other tags are indistinguishable from zero; GRPO preserves but does not extend the pattern, consistent with soft tokens being absent from the reward.}}{21}{figure.caption.21}\protected@file@percent }
\newlabel{fig:soft-token-forest}{{12}{21}{Soft-token discrimination. For each soft value with a biologically meaningful probe, $\Delta $ is the difference in probe-hit rate between prompts that carry that tag and prompts that carry some other value in the same category; error bars are bootstrap $95\%$ intervals; stars mark Fisher $p<0.05$ ($\ast $), $<0.01$ ($\ast \ast $), $<0.001$ ($\ast \ast \ast $). \texttt {VEC\_LENTIVIRAL} and \texttt {VEC\_AAV} show large, significant conditioning effects in both the pretrained base and the post-GRPO model. Most other tags are indistinguishable from zero; GRPO preserves but does not extend the pattern, consistent with soft tokens being absent from the reward}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \texttt  {COPY\_} conditioning, stacked by outcome. \emph  {correct} = the requested copy class's origin was detected; \emph  {wrong} = the opposing class's origin was detected instead; \emph  {unclassified} = a non-discriminative origin (e.g.\ ORI\_F1, ORI\_SV40, ORI\_2$\mu $) was detected; \emph  {no\_signal} = no origin detected. \texttt  {COPY\_HIGH} partially works in both runs; \texttt  {COPY\_LOW} is effectively ignored, with the model outputting a high-copy origin far more often than a low-copy one when low copy is requested.}}{22}{figure.caption.22}\protected@file@percent }
\newlabel{fig:soft-token-copy}{{13}{22}{\texttt {COPY\_} conditioning, stacked by outcome. \emph {correct} = the requested copy class's origin was detected; \emph {wrong} = the opposing class's origin was detected instead; \emph {unclassified} = a non-discriminative origin (e.g.\ ORI\_F1, ORI\_SV40, ORI\_2$\mu $) was detected; \emph {no\_signal} = no origin detected. \texttt {COPY\_HIGH} partially works in both runs; \texttt {COPY\_LOW} is effectively ignored, with the model outputting a high-copy origin far more often than a low-copy one when low copy is requested}{figure.caption.22}{}}
