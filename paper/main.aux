\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Pre-GRPO base model, small temperature sweep ($n=100$ per cell; matched $n=1000$ run for $t=0.7$ for comparison). Base prompt fidelity peaks at $t=0.3$ ($37.8\%$) and degrades at higher temperatures; the matched $t=0.7$ setting is therefore already near the base's optimum, so the GRPO advantage reported in the main text is not explained by temperature tuning on the base.}}{14}{figure.caption.12}\protected@file@percent }
\newlabel{fig:temperature_sweep}{{6}{14}{Pre-GRPO base model, small temperature sweep ($n=100$ per cell; matched $n=1000$ run for $t=0.7$ for comparison). Base prompt fidelity peaks at $t=0.3$ ($37.8\%$) and degrades at higher temperatures; the matched $t=0.7$ setting is therefore already near the base's optimum, so the GRPO advantage reported in the main text is not explained by temperature tuning on the base}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Oracle best-of-$K$ for $K \in \{1, 2, 4\}$ on the paired $n=1000$ evaluation. Left: structural plausibility. Right: composite ``useful'' rate (plausible $\land $ fidelity $\geq 0.5$). Shaded bands are Wilson $95\%$ CIs. GRPO stays strictly above base across all $K$; rejection sampling does not close the gap even with ground-truth ranking.}}{14}{figure.caption.13}\protected@file@percent }
\newlabel{fig:best_of_k}{{7}{14}{Oracle best-of-$K$ for $K \in \{1, 2, 4\}$ on the paired $n=1000$ evaluation. Left: structural plausibility. Right: composite ``useful'' rate (plausible $\land $ fidelity $\geq 0.5$). Shaded bands are Wilson $95\%$ CIs. GRPO stays strictly above base across all $K$; rejection sampling does not close the gap even with ground-truth ranking}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Per-token hit rate, rank-ordered by the maximum of the base and GRPO rates. Each row shows one hard token: base (grey) and GRPO (green) dots connected by a light line to highlight the shift. Category colour strip on the far left. Right panel is $n_{\text  {requested}}$ in the paired eval on a log scale. The figure makes two patterns visible: GRPO uniformly lifts the already-detectable tokens, and a long tail of rare tokens stays at zero in both runs (the zero-hit tail is the same set that explains the TAG regression and the \texttt  {COPY\_LOW} soft-token failure in Section~\ref {sec:soft-tokens}).}}{15}{figure.caption.14}\protected@file@percent }
\newlabel{fig:per-token}{{8}{15}{Per-token hit rate, rank-ordered by the maximum of the base and GRPO rates. Each row shows one hard token: base (grey) and GRPO (green) dots connected by a light line to highlight the shift. Category colour strip on the far left. Right panel is $n_{\text {requested}}$ in the paired eval on a log scale. The figure makes two patterns visible: GRPO uniformly lifts the already-detectable tokens, and a long tail of rare tokens stays at zero in both runs (the zero-hit tail is the same set that explains the TAG regression and the \texttt {COPY\_LOW} soft-token failure in Section~\ref {sec:soft-tokens})}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Soft-token discrimination. For each soft value with a biologically meaningful probe, $\Delta $ is the difference in probe-hit rate between prompts that carry that tag and prompts that carry some other value in the same category; error bars are bootstrap $95\%$ intervals; stars mark Fisher $p<0.05$ ($\ast $), $<0.01$ ($\ast \ast $), $<0.001$ ($\ast \ast \ast $). \texttt  {VEC\_LENTIVIRAL} and \texttt  {VEC\_AAV} show large, significant conditioning effects in both the pretrained base and the post-GRPO model. Most other tags are indistinguishable from zero; GRPO preserves but does not extend the pattern, consistent with soft tokens being absent from the reward.}}{16}{figure.caption.16}\protected@file@percent }
\newlabel{fig:soft-token-forest}{{9}{16}{Soft-token discrimination. For each soft value with a biologically meaningful probe, $\Delta $ is the difference in probe-hit rate between prompts that carry that tag and prompts that carry some other value in the same category; error bars are bootstrap $95\%$ intervals; stars mark Fisher $p<0.05$ ($\ast $), $<0.01$ ($\ast \ast $), $<0.001$ ($\ast \ast \ast $). \texttt {VEC\_LENTIVIRAL} and \texttt {VEC\_AAV} show large, significant conditioning effects in both the pretrained base and the post-GRPO model. Most other tags are indistinguishable from zero; GRPO preserves but does not extend the pattern, consistent with soft tokens being absent from the reward}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \texttt  {COPY\_} conditioning, stacked by outcome. \emph  {correct} = the requested copy class's origin was detected; \emph  {wrong} = the opposing class's origin was detected instead; \emph  {unclassified} = a non-discriminative origin (e.g.\ ORI\_F1, ORI\_SV40, ORI\_2$\mu $) was detected; \emph  {no\_signal} = no origin detected. \texttt  {COPY\_HIGH} partially works in both runs; \texttt  {COPY\_LOW} is effectively ignored, with the model outputting a high-copy origin far more often than a low-copy one when low copy is requested.}}{17}{figure.caption.17}\protected@file@percent }
\newlabel{fig:soft-token-copy}{{10}{17}{\texttt {COPY\_} conditioning, stacked by outcome. \emph {correct} = the requested copy class's origin was detected; \emph {wrong} = the opposing class's origin was detected instead; \emph {unclassified} = a non-discriminative origin (e.g.\ ORI\_F1, ORI\_SV40, ORI\_2$\mu $) was detected; \emph {no\_signal} = no origin detected. \texttt {COPY\_HIGH} partially works in both runs; \texttt {COPY\_LOW} is effectively ignored, with the model outputting a high-copy origin far more often than a low-copy one when low copy is requested}{figure.caption.17}{}}
