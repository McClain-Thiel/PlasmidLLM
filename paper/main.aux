\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Useful-plasmid rate ($T{=}0.5$) on the held-out $1{,}000$-prompt benchmark. Single-shot uses temperature $0.7$, top-$p{=}0.95$, top-$k{=}50$; best-of-$K$ ranks $K$ independent draws per prompt by the annotation pipeline (oracle ranker, four seeds). The real Addgene reference panel admits no useful rate at $T{=}0.5$ because real plasmids have no original prompt to be faithful to; the same pipeline reports structural plausibility of $95.0\%$ on the panel and $0.0\%$ on random and dinucleotide-shuffled controls (compare Figure~\ref {fig:bok}, left panel).}}{7}{table.caption.5}\protected@file@percent }
\newlabel{tab:useful_main}{{1}{7}{Useful-plasmid rate ($T{=}0.5$) on the held-out $1{,}000$-prompt benchmark. Single-shot uses temperature $0.7$, top-$p{=}0.95$, top-$k{=}50$; best-of-$K$ ranks $K$ independent draws per prompt by the annotation pipeline (oracle ranker, four seeds). The real Addgene reference panel admits no useful rate at $T{=}0.5$ because real plasmids have no original prompt to be faithful to; the same pipeline reports structural plausibility of $95.0\%$ on the panel and $0.0\%$ on random and dinucleotide-shuffled controls (compare Figure~\ref {fig:bok}, left panel)}{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Best-of-$K$ for $K \in \{1, 2, 4\}$ on the paired $n{=}1{,}000$ benchmark, oracle ranker. Left: structural plausibility, with the dashed line marking the real-Addgene plausibility rate ($95.0\%$). Right: useful-plasmid rate ($T{=}0.5$). Wilson $95\%$ bands shaded. Post-GRPO is strictly above the supervised base at every $K$ on both metrics; the post-GRPO plausibility curve passes the real-Addgene reference at $K{=}4$ ($95.8\%$). The useful-rate gap stays in the $+9.8$ to $+13.2$~pp range across $K$. The reference line is plausibility only --- useful-rate at $T{=}0.5$ is not defined for real Addgene because real plasmids have no original prompt to be faithful to.}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:bok}{{3}{7}{Best-of-$K$ for $K \in \{1, 2, 4\}$ on the paired $n{=}1{,}000$ benchmark, oracle ranker. Left: structural plausibility, with the dashed line marking the real-Addgene plausibility rate ($95.0\%$). Right: useful-plasmid rate ($T{=}0.5$). Wilson $95\%$ bands shaded. Post-GRPO is strictly above the supervised base at every $K$ on both metrics; the post-GRPO plausibility curve passes the real-Addgene reference at $K{=}4$ ($95.8\%$). The useful-rate gap stays in the $+9.8$ to $+13.2$~pp range across $K$. The reference line is plausibility only --- useful-rate at $T{=}0.5$ is not defined for real Addgene because real plasmids have no original prompt to be faithful to}{figure.caption.6}{}}
